PORT=41821
DATABASE_URL=postgres://mushroom:mushroom@127.0.0.1:5432/mushroom
REDIS_URL=redis://127.0.0.1:6379
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_ENABLED=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mushroom-snapshots
# 热盘路径。留空则用 compose 命名卷 minio-hot。冷盘与复制见 docs/OPS_STORAGE_BACKUP.md
# MINIO_HOT_DATA=/mnt/ssd/minio
# MINIO_APPLY_TIER=1
# MINIO_COLD_ENDPOINT=127.0.0.1:9002
# MINIO_COLD_ACCESS_KEY=minioadmin
# MINIO_COLD_SECRET_KEY=minioadmin
# MINIO_COLD_BUCKET=mushroom-snapshots
# OBJECT_HOT_DAYS=90
# BACKUP_DIR=backups
# BACKUP_VIA=pg_dump
JWT_SECRET=dev-only-change-me
INGEST_TOKEN=dev-ingest-token
SEED_ON_START=true
TYPEORM_SYNC=false
# 严重告警推送。留空则该通道关闭，不报错。
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
# 钉钉机器人加签密钥。留空则不签名。
DINGTALK_WEBHOOK_SECRET=
